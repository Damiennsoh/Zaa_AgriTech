# ZAA Environment Configuration
# Copy this to .env and fill in your credentials

# Supabase (server-only backend credentials)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Legacy projects may use SUPABASE_SERVICE_ROLE_KEY instead.

# Frontend-safe Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=zaa_verify_token_2024

# AI APIs
GROQ_API_KEY=your_groq_api_key
HF_API_TOKEN=your_huggingface_token

# MTN MoMo API
MOMO_API_USER=your_momo_user
MOMO_API_KEY=your_momo_key
MOMO_SUBSCRIPTION_KEY=your_momo_subscription_key
